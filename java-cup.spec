Name:		java-cup
Version:	0.10k
Release:	1
Summary:	LALR parser generator
Group:		Development/Java
License:	MIT-CMU
URL:		https://www.cs.princeton.edu/~appel/modern/java/CUP/
# CUP 0.10k. The upstream tarball ships prebuilt class files; those are
# removed before this archive is stored.
Source0:	https://www.cs.princeton.edu/~appel/modern/java/CUP/java_cup_v10k.tar.gz#/java-cup-%{version}.tar.gz

BuildArch:	noarch
BuildRequires:	java-current-devel
BuildRequires:	sysjar

%description
CUP %{version} is a LALR parser generator for Java.
Xalan XSLTC's XPath parser, generated by this CUP release, extends
java_cup.runtime.lr_parser.

%prep
%autosetup -n java-cup-%{version} -p1
find . \( -name '*.jar' -o -name '*.class' -o -name '*.so' -o -name '*.node' -o -name '*.wasm' \) -delete

%build
find java_cup -name '*.java' ! -path '*/simple_calc/*' > sources.list
test "$(wc -l < sources.list)" -eq 35
mkdir -p classes
javac --release 8 -encoding UTF-8 -d classes @sources.list
jar cf java-cup.jar -C classes .
jar tf java-cup.jar | grep -E '\.(java|class)$' | grep -v '\.class$' && exit 1 || true

cat > java-cup.pom << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>java_cup</groupId>
  <artifactId>java_cup</artifactId>
  <version>0.10k</version>
  <name>java-cup</name>
  <description>LALR parser generator</description>
  <licenses>
    <license>
      <name>MIT-CMU</name>
    </license>
  </licenses>
</project>
EOF

%install
sysjar install --buildroot %{buildroot} \
	--artifact java-cup.pom:java-cup.jar \
	--file-name java-cup \
	--filelist .mfiles

%check
mkdir -p check
cat > check/Smoke.java << 'END'
import java_cup.runtime.Symbol;
public class Smoke {
	public static void main(String[] args) {
		Symbol symbol = new Symbol(7, "cup");
		System.out.println("cup_ok " + symbol.sym + " " + symbol.value);
	}
}
END
JAR=%{buildroot}%{_javadir}/java-cup.jar
test -f "$JAR"
javac --release 8 -encoding UTF-8 -cp "$JAR" -d check check/Smoke.java
java -cp "check:$JAR" Smoke > check/out.txt
cat check/out.txt
grep -F -q 'cup_ok 7 cup' check/out.txt

%files -f .mfiles
%doc LICENSE README
